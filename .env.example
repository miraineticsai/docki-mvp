# ==============================================================================
# Aura Health Clinic — Environment Variables Configuration
# ==============================================================================

# 1. Database: Neon PostgreSQL Connection URL
# How to get your Neon DATABASE_URL:
#   1. Go to https://neon.tech and create a free project
#   2. Open your project → Connection Details
#   3. Select "Pooled connection" (recommended for serverless / Next.js)
#   4. Copy the connection string (with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 2. Admin Authentication Credentials
# Used by Dr. Rajesh Kulkarni & clinic staff to log in at /admin/login
# Default fallback if not set: doctor@auraclinic.com / AuraDoc@2026!
ADMIN_EMAIL=doctor@auraclinic.com
ADMIN_PASSWORD=AuraDoc@2026!

# 3. Admin Session Encryption Secret (32+ random characters)
# Used to sign HTTP-only session cookies with HMAC-SHA256
ADMIN_SESSION_SECRET=aura-clinic-pune-secure-admin-token-secret-2026-key

# 4. Optional API Secret for n8n / Chatbot Webhooks
# Protects GET /api/appointments polling and webhook integration
ADMIN_API_SECRET=your_super_secret_webhook_token_here

# 5. n8n AI Chatbot Webhook URL
# Server-side only: Next.js API /api/chat forwards patient questions to this webhook.
# Production format: https://your-n8n-domain.com/webhook/clinic-chat
# Test format: https://your-n8n-domain.com/webhook-test/clinic-chat
N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/your-webhook-path